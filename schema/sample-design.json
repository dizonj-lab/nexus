 "ea": [
  {
   "id": "P1",
   "t": "Zero trust. Never trust the network; authenticate and authorize every hop with mTLS and short-lived tokens."
  },
  {
   "id": "P2",
   "t": "Design for failure. Instance-based components run 2+ instances across zones; zonal managed services run one per zone; regional managed services rely on the provider across zones and need a cross-region DR plan that meets their RTO; data stores run active/passive at minimum."
  },
  {
   "id": "P3",
   "t": "Reuse before buy before build. Prefer catalogued capabilities; new platforms need an ADR."
  },
  {
   "id": "P4",
   "t": "Design for 60% steady-state utilization so the system absorbs a 1.6× burst."
  },
  {
   "id": "P5",
   "t": "Segment by trust zone. Each perimeter is default-deny; flows only move one zone at a time."
  },
  {
   "id": "P6",
   "t": "Scale the simplest way first: cache, then scale up, then read replicas, and shard only when nothing else fits."
  },
  {
   "id": "P7",
   "t": "Protect before you scale. Rate-limit at the edge so one client or a burst cannot take the platform down."
  },
  {
   "id": "P8",
   "t": "Each service owns its data. Other services use its API or its events, never its database."
  }
 ],
 "gt": [
  {
   "id": "GT1",
   "t": "TLS 1.2+ on every flow, including east-west.",
   "src": "Security Standard SS-04 §3"
  },
  {
   "id": "GT2",
   "t": "No public object storage.",
   "src": "OPA policy deny_public_bucket.rego"
  },
  {
   "id": "GT3",
   "t": "Internet-facing endpoints sit behind a WAF.",
   "src": "CIS Controls v8 · 13.10"
  },
  {
   "id": "GT4",
   "t": "Data stores are encrypted at rest with customer-managed keys.",
   "src": "Data Protection Policy DP-2"
  },
  {
   "id": "GT5",
   "t": "Traffic to third parties uses private connectivity or the egress gateway with an FQDN allow-list.",
   "src": "Network Security Standard NS-07"
  }
 ],
