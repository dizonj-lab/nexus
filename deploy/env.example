# Copy to deploy/.env (buddy.sh does this for you with random secrets). Never commit .env.
POSTGRES_PASSWORD=change-me
NEXUS_SECRET_KEY=change-me-to-64-random-characters
# First administrator, created only while the database has no users.
NEXUS_ADMIN_EMAIL=you@example.com
NEXUS_ADMIN_PASSWORD=Change-Me-2026
NEXUS_ADMIN_NAME=Your Name
# Host port and interface for the web edge.
NEXUS_PORT=8088
NEXUS_BIND=0.0.0.0
# true when NEXUS is served over HTTPS (e.g. behind a Cloudflare tunnel)
NEXUS_COOKIE_SECURE=false
# OpenAI-compatible model server (Ollama on Buddy by default) and models
NEXUS_LLM_UPSTREAM=http://host.docker.internal:11434
NEXUS_SLM_MODEL=qwen2.5:7b-instruct
NEXUS_LLM_MODEL=gpt-oss:latest
