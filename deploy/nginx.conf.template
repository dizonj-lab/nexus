# Rendered at container start by the nginx image (envsubst). Only defined
# environment variables are substituted, so nginx's own $uri etc. stay intact.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 4m;
  absolute_redirect off;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Content-Security-Policy "frame-ancestors 'self'" always;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location = /healthz { return 200 "ok\n"; }
  location = /version.txt { }

  # Sign-in check used by the protected locations below.
  location = /_auth {
    internal;
    proxy_pass http://backend:8000/api/auth/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
  }
  location @login { return 302 /login?next=$request_uri; }

  location /api/ {
    proxy_pass http://backend:8000;
    proxy_read_timeout 300s;   # agent runs on a local model can take minutes
  }

  # The model server, for signed-in users only: /llm/v1/... -> OpenAI-compatible server on Buddy.
  location /llm/ {
    auth_request /_auth;
    proxy_pass ${NEXUS_LLM_UPSTREAM}/;
    # Ollama answers 403 to browser requests whose Origin it does not know.
    proxy_set_header Origin "";
    proxy_set_header Host localhost;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
  }

  # NEXUS's own architecture (LikeC4), for signed-in users only.
  location /c4/ {
    auth_request /_auth;
    error_page 401 = @login;
    try_files $uri $uri/ /c4/index.html;
  }

  # Everything else is the web app (landing page, sign-in, projects, embedded canvas).
  location / {
    proxy_pass http://frontend:3000;
  }
}
