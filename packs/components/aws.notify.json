{
 "id": "aws.notify",
 "version": "1.0.0",
 "title": "Amazon SNS and Amazon EventBridge",
 "owner": "team-integration",
 "layer": "vendor",
 "schema": "nexus-pack/1",
 "applies_to": {
  "type": "notify",
  "provider": "aws"
 },
 "facts": [
  {
   "id": "publish_rate",
   "label": "Publish rate per account per Region (SNS)",
   "kind": "quota",
   "default": 300,
   "min": null,
   "max": null,
   "unit": "messages/s",
   "adjustable": true,
   "source": "https://docs.aws.amazon.com/general/latest/gr/sns.html",
   "checked": "2026-11-06",
   "note": "300 in most Regions; 1,500 in several; 9,000 in us-west-2 and eu-west-1; 30,000 in us-east-1. Check Service Quotas for your Region.",
   "flavor": "topic",
   "sim": "rps"
  },
  {
   "id": "msg_size",
   "label": "Message size (SNS)",
   "kind": "setting",
   "default": 256,
   "min": null,
   "max": 1024,
   "unit": "KiB",
   "adjustable": true,
   "source": "https://docs.aws.amazon.com/general/latest/gr/sns.html",
   "checked": "2026-11-06",
   "note": "Up to 1 MiB only for topics with 100 or fewer subscriptions, all SQS, Lambda or Firehose.",
   "flavor": "topic"
  },
  {
   "id": "subs",
   "label": "Subscriptions per standard topic",
   "kind": "quota",
   "default": 12500000,
   "min": null,
   "max": null,
   "unit": "subscriptions",
   "adjustable": true,
   "source": "https://docs.aws.amazon.com/general/latest/gr/sns.html",
   "checked": "2026-11-06",
   "flavor": "topic"
  },
  {
   "id": "fifo_topic",
   "label": "FIFO throughput per topic",
   "kind": "limit",
   "default": 3000,
   "min": null,
   "max": null,
   "unit": "messages/s",
   "adjustable": null,
   "source": "https://docs.aws.amazon.com/sns/latest/dg/fifo-message-grouping.html",
   "checked": "2026-11-06",
   "note": "Or 20 MB/s. 300 messages/s per message group.",
   "flavor": "topic"
  },
  {
   "id": "fifo_subs",
   "label": "Subscriptions per FIFO topic",
   "kind": "quota",
   "default": 100,
   "min": null,
   "max": null,
   "unit": "subscriptions",
   "adjustable": true,
   "source": "https://docs.aws.amazon.com/general/latest/gr/sns.html",
   "checked": "2026-11-06",
   "flavor": "topic"
  },
  {
   "id": "fifo_protocols",
   "label": "FIFO topics deliver only to SQS queues",
   "kind": "limit",
   "default": null,
   "min": null,
   "max": null,
   "unit": "protocols",
   "adjustable": false,
   "source": "https://docs.aws.amazon.com/sns/latest/dg/fifo-message-delivery.html",
   "checked": "2026-11-06",
   "note": "FIFO or standard queues; Lambda and HTTPS go through a queue.",
   "flavor": "topic"
  },
  {
   "id": "filter_keys",
   "label": "Attribute names per filter policy",
   "kind": "limit",
   "default": null,
   "min": null,
   "max": 5,
   "unit": "keys",
   "adjustable": false,
   "source": "https://docs.aws.amazon.com/sns/latest/dg/subscription-filter-policy-constraints.html",
   "checked": "2026-11-06",
   "note": "At most 150 value combinations.",
   "flavor": "topic"
  },
  {
   "id": "http_retries",
   "label": "HTTP/S delivery retries (default policy)",
   "kind": "setting",
   "default": 3,
   "min": null,
   "max": null,
   "unit": "retries",
   "adjustable": true,
   "source": "https://docs.aws.amazon.com/sns/latest/dg/sns-message-delivery-retries.html",
   "checked": "2026-11-06",
   "note": "20 s apart; custom policies up to 3,600 s in total.",
   "flavor": "topic"
  },
  {
   "id": "archive",
   "label": "FIFO message archive and replay",
   "kind": "setting",
   "default": null,
   "min": 1,
   "max": 365,
   "unit": "days",
   "adjustable": null,
   "source": "https://docs.aws.amazon.com/sns/latest/dg/fifo-message-archiving-replay.html",
   "checked": "2026-11-06",
   "note": "FIFO topics only.",
   "flavor": "topic"
  },
  {
   "id": "putevents",
   "label": "PutEvents per Region (EventBridge)",
   "kind": "quota",
   "default": 400,
   "min": null,
   "max": null,
   "unit": "requests/s",
   "adjustable": true,
   "source": "https://docs.aws.amazon.com/eventbridge/latest/userguide/eb-quota.html",
   "checked": "2026-11-06",
   "note": "10,000 in us-east-1, us-west-2 and eu-west-1.",
   "flavor": "bus",
   "sim": "rps"
  },
  {
