   "label": "Event size (EventBridge)",
   "kind": "limit",
   "default": null,
   "min": null,
   "max": 256,
   "unit": "KB",
   "adjustable": false,
   "source": "https://docs.aws.amazon.com/eventbridge/latest/userguide/eb-putevent-size.html",
   "checked": "2026-11-06",
   "flavor": "bus"
  },
  {
   "id": "rules",
   "label": "Rules per event bus",
   "kind": "quota",
   "default": 300,
   "min": null,
   "max": null,
   "unit": "rules",
   "adjustable": true,
   "source": "https://docs.aws.amazon.com/eventbridge/latest/userguide/eb-quota.html",
   "checked": "2026-11-06",
   "flavor": "bus"
  },
  {
   "id": "targets",
   "label": "Targets per rule",
   "kind": "limit",
   "default": null,
   "min": null,
   "max": 5,
   "unit": "targets",
   "adjustable": false,
   "source": "https://docs.aws.amazon.com/eventbridge/latest/userguide/eb-quota.html",
   "checked": "2026-11-06",
   "flavor": "bus"
  },
  {
   "id": "invocations",
   "label": "Target invocations per Region",
   "kind": "quota",
   "default": 750,
   "min": null,
   "max": null,
   "unit": "invocations/s",
   "adjustable": true,
   "source": "https://docs.aws.amazon.com/eventbridge/latest/userguide/eb-quota.html",
   "checked": "2026-11-06",
   "note": "18,750 in us-east-1. Above it, deliveries are delayed, not dropped.",
   "flavor": "bus"
  },
  {
   "id": "retry_age",
   "label": "Retry window (default)",
   "kind": "setting",
   "default": 24,
   "min": null,
   "max": 24,
   "unit": "hours",
   "adjustable": true,
   "source": "https://docs.aws.amazon.com/eventbridge/latest/userguide/eb-rule-retry-policy.html",
   "checked": "2026-11-06",
   "note": "Up to 185 attempts, then dropped unless a dead-letter queue is set.",
   "flavor": "bus"
  }
 ]
}
