{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://nexus/packs/pack.schema.json",
 "title": "NEXUS knowledge pack",
 "type": "object",
 "required": ["id", "version", "title", "owner", "layer", "schema", "applies_to"],
 "properties": {
  "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
  "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
  "title": { "type": "string", "minLength": 3 },
  "owner": { "type": "string", "pattern": "^team-[a-z0-9-]+$" },
  "layer": { "enum": ["vendor", "industry", "organisation", "project"] },
  "schema": { "const": "nexus-pack/1" },
  "applies_to": {
   "type": "object", "required": ["type", "provider"],
   "properties": { "type": { "type": "string" }, "provider": { "enum": ["aws", "azure", "gcp", "vmware", "*"] } }
  },
  "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
  "rules": {
   "type": "array",
   "items": { "type": "object", "required": ["id", "check", "severity"], "properties": { "id": { "type": "string" }, "check": { "type": "string" }, "severity": { "enum": ["info", "warn", "crit"] }, "facts": { "type": "array", "items": { "type": "string" } } } }
  },
  "tiers": { "type": "object" }, "types": { "type": "object" }, "families": { "type": "object" }, "zones": { "type": "object" }, "reserved_ips": { "type": "object" }
 },
 "$defs": {
  "fact": {
   "type": "object",
   "required": ["id", "label", "kind", "unit", "source", "checked"],
   "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "label": { "type": "string" },
    "kind": { "enum": ["quota", "limit", "setting", "behaviour"], "description": "quota: adjustable provider quota · limit: hard limit · setting: you choose within min and max · behaviour: how the service acts" },
    "default": { "type": ["number", "null"] }, "min": { "type": ["number", "null"] }, "max": { "type": ["number", "null"] },
    "unit": { "type": "string" },
    "adjustable": { "type": ["boolean", "null"] },
    "source": { "type": "string", "pattern": "^https://(docs\\.aws\\.amazon\\.com|learn\\.microsoft\\.com|docs\\.cloud\\.google\\.com|cloud\\.google\\.com)/" },
    "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string" }, "field": { "type": "string" }, "sim": { "enum": ["rps", "gbps"] },
    "rps_per_unit": { "type": "number" }, "verified": { "type": "boolean" }
   }
  }
 }
}
